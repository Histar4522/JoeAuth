{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "joe-auth",
	"main": "src/index.ts",
	"compatibility_date": "2026-11-10",
	"assets": {
		"binding": "ASSETS",
		"directory": "./public",
		"run_worker_first": false
	},
	"observability": {
		"enabled": true
	},
	"upload_source_maps": true,
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "joe-auth-db",
			"database_id": "00000000-0000-0000-0000-000000000000",
			"migrations_dir": "migrations"
		}
	],
	"kv_namespaces": [
		{
			"binding": "AUTH_CACHE",
			"id": "00000000000000000000000000000000"
		}
	],
	"ratelimits": [
		{
			"name": "AUTH_RATE_LIMITER",
			"namespace_id": "1001",
			"simple": {
				"limit": 15,
				"period": 60
			}
		},
		{
			"name": "TOKEN_RATE_LIMITER",
			"namespace_id": "1002",
			"simple": {
				"limit": 60,
				"period": 60
			}
		}
	],
	"triggers": {
		"crons": [
			"0 3 * * *"
		]
	},
	"vars": {
		"APP_NAME": "JoeAuth",
		"ISSUER_URL": "http://localhost:8787",
		"EMAIL_FROM": "JoeAuth <onboarding@resend.dev>",
		"TURNSTILE_SITE_KEY": "1x00000000000000000000AA",
		"REQUIRE_EMAIL_VERIFICATION": "true"
	}
}
